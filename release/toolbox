#!/bin/sh
# Kept for backwards compatibility: use ../dev instead (./dev help in the project root)
DEV="$(cd "$(dirname "$0")/.." && pwd)/dev"

case "$1" in
start) exec "$DEV" up -f ;;
build) exec "$DEV" rebuild ;;
stop) exec "$DEV" down ;;
*)
    echo "Usage: sh toolbox start|build|stop  (or use ./dev in the project root)"
    exit 1
    ;;
esac
