#!/bin/bash
# Helper for running the demo with Docker Compose
set -e

case "$1" in
start)
    echo "Starting the container..."
    docker compose up --build
    ;;
build)
    echo "Rebuilding the container from scratch..."
    docker compose down
    docker compose build --no-cache
    docker compose up --force-recreate
    ;;
stop)
    docker compose down
    ;;
*)
    echo "Usage: sh toolbox start|build|stop"
    exit 1
    ;;
esac
